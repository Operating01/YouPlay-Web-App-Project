@* Views/Playlist/Details.cshtml *@
@model Project.Models.Entities.Playlist
@using System.Security.Claims

@{
    ViewData["Title"] = Model.PlaylistTitle;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isOwner = currentUserId == Model.AccountId;
}

<div class="playlist-details-container" style="margin-left: 250px; padding: 40px;">
    
    @if (!isOwner)
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle me-2"></i>
            This is a read-only playlist. You can view and play songs, but cannot edit or delete it.
        </div>
    }
    
    <!-- Playlist Header -->
    <div class="text-center mb-4">
        <!-- Album Art - Dynamic -->
        <div class="playlist-cover mx-auto mb-3" style="width: 250px; height: 250px; border: 2px solid #000; display: flex; align-items: center; justify-content: center; background-color: #f8f9fa; overflow: hidden;">
            @if (Model.PlaylistArt != null && !string.IsNullOrEmpty(Model.PlaylistArt.ToString()))
            {
                <img src="@Model.PlaylistArt" alt="@Model.PlaylistTitle" style="width: 100%; height: 100%; object-fit: cover;">
            }
            else
            {
                <span style="font-size: 18px; color: #6c757d;">Insert Art</span>
            }
        </div>
        
        <!-- Playlist Name -->
        <h2 class="playlist-title" style="font-size: 2.5rem; font-weight: bold; border-bottom: 3px solid #000; padding-bottom: 10px; display: inline-block;">
            @Model.PlaylistTitle
        </h2>
        
        @if (isOwner)
        {
            <button class="btn btn-sm btn-outline-secondary ms-2" id="editPlaylistButton">
                <i class="bi bi-pencil"></i> Edit
            </button>
        }
    </div>

    <!-- Songs Collection -->
    <div class="songs-collection" style="border: 2px solid #000; padding: 40px; min-height: 400px; background-color: #fff;">
        @if (Model.PlaylistSongs != null && Model.PlaylistSongs.Any())
        {
            <div id="playlistSongs">
                @foreach (var playlistSong in Model.PlaylistSongs)
                {
                    <div class="song-card-wrapper" data-song-id="@playlistSong.Song.SongId" data-video-id="@playlistSong.Song.IdInYouTube">
                        <!-- Song Card -->
                        <div class="card mb-2 song-card" style="cursor: pointer;">
                            <div class="card-body d-flex align-items-center p-2">
                                <!-- Thumbnail -->
                                <div class="song-thumbnail me-3" style="min-width: 80px; width: 80px; height: 60px;">
                                    @if (!string.IsNullOrEmpty(playlistSong.Song.AlbumArt))
                                    {
                                        <img src="@playlistSong.Song.AlbumArt" alt="Thumbnail" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;">
                                    }
                                    else
                                    {
                                        <div style="width: 100%; height: 100%; background-color: #e9ecef; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
                                            <span class="text-muted small">No Image</span>
                                        </div>
                                    }
                                </div>

                                <!-- Song Info -->
                                <div style="flex: 1; min-width: 0;">
                                    <h6 class="card-title mb-1" style="font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @playlistSong.Song.SongTitle
                                    </h6>
                                    <p class="card-text text-muted mb-0" style="font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @playlistSong.Song.Artists
                                    </p>
                                </div>

                                <!-- Remove Button - Only for owner -->
                                @if (isOwner)
                                {
                                    <button class="btn btn-sm btn-danger ms-2 remove-song-btn" 
                                            data-playlist-id="@Model.PlaylistId" 
                                            data-song-id="@playlistSong.Song.SongId"
                                            type="button">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-music-note-list" style="font-size: 4rem;"></i>
                <p class="mt-3">No songs in this playlist yet. @(isOwner ? "Start adding some!" : "")</p>
            </div>
        }
    </div>

    <!-- Action Buttons -->
    <div class="mt-4 d-flex justify-content-between">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
        
        @if (isOwner)
        {
            <form asp-action="Delete" asp-route-id="@Model.PlaylistId" method="post" 
                  onsubmit="return confirm('Are you sure you want to delete this playlist?');">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete Playlist
                </button>
            </form>
        }
    </div>
</div>

@* Rest of your scripts... *@

<div class="modal fade" id="editPlaylistModal" tabindex="-1" aria-labelledby="editPlaylistModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPlaylistModalLabel">Edit Playlist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editPlaylistForm">
                    <div class="mb-3">
                        <label for="editPlaylistTitle" class="form-label">Playlist Name</label>
                        <input type="text" class="form-control" id="editPlaylistTitle" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaylistDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editPlaylistDescription" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaylistArtUrl" class="form-label">Playlist Art URL</label>
                        <input type="text" class="form-control" id="editPlaylistArtUrl">
                    </div>
                </form>
                <img id="editArtPreview" src="" alt="Preview" class="img-fluid mt-2" style="display:none; max-height:200px;">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="savePlaylistEdits">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="module">
        import { MainDOMManip } from '/js/MainDOMManip.js';
        newManip = new MainDOMManip();
        newManip.setUpEventListeners();
    </script>
}

<style>
    .playlist-cover {
        transition: transform 0.2s;
    }
    
    .playlist-cover:hover {
        transform: scale(1.05);
    }
    
    .song-card {
        transition: all 0.2s;
        border: 1px solid #dee2e6;
    }
    
    .song-card:hover {
        transform: translateX(5px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .remove-song-btn {
        opacity: 0;
        transition: opacity 0.2s;
    }
    
    .song-card-wrapper:hover .remove-song-btn {
        opacity: 1;
    }
</style>