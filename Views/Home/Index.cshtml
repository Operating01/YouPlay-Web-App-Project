
@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<h1>@ViewData["Title"]</h1>
@model Project.Models.Entities.Song
<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Discover and play music from YouTube</p>
</div>

<!-- Featured Playlists Section -->
<div class="featured-playlists mt-5">
    <h3 class="mb-4">
        <i class="bi bi-stars me-2"></i>Featured Playlists
    </h3>
    <div id="featuredPlaylistsContainer" class="row g-3">
        <!-- Playlists will be loaded here -->
        <div class="col-12 text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script type="module">
        import { MainDOMManip } from '/js/MainDOMManip.js';
        const newManip = new MainDOMManip();
        newManip.setUpEventListeners();
    </script>
}